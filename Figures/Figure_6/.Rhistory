library(openxlsx)
library(ggplot2)
library(patchwork)
library(tidyr)
library(dplyr)
table_S1 <- read.xlsx("Supplementary_Table_S1.xlsx", startRow = 4)
table_S1 <- table_S1[!(is.na(table_S1$`LNET.k.=.4.archetype`)), ]
table_S14 <- read.xlsx("Supplementary_Table_S14.xlsx", startRow = 4)
# Create Figure 5d
table_S14 <- table_S14[which(table_S14$sample.id %in% table_S1$sample.id[which(table_S1$cohort.LNET=="TRUE")]), ]
table_S14 <- table_S14[,c(1:11)]
colnames(table_S14) <- gsub("quantiseq.", "", colnames(table_S14))
table_S14$group <- sapply(table_S14$sample.id, function(x) table_S1$`LNET.k.=.4.archetype`[which(table_S1$sample.id==x)])
table_S14[,2:11] <- sweep(table_S14[,2:11],1,rowSums(table_S14[,2:11]),"/")
quantiseq.long <- table_S14 %>% pivot_longer(cols = `B.cell`:`Myeloid.dendritic.cell`,names_to = "Cell_type",values_to = "Proportion")
View(quantiseq.long)
quantiseq.long.mean <- quantiseq.long %>% group_by(group,Cell_type) %>% summarise(Mean_prop = mean(Proportion))
# find max number of samples to scale all plots
nmax <- max(table(table_S14$group)) # 109
cell10 <- c("Myeloid.dendritic.cell"="#882E72","Monocyte"="#1965B0","Macrophage.M2"="#5289C7","Macrophage.M1"="#7BAFDE",
"Neutrophil"="#4EB265","NK.cell"="#CAE0AB","T.cell.CD4+.(non-regulatory)"="#F7F056","T.cell.CD8+"="#F4A736",
"B.cell"="#E8601C","T.cell.regulatory.(Tregs)"="#DC050C")
# A1
quantiseq.long$Cell_type <- factor(as.character(quantiseq.long$Cell_type), levels = quantiseq.long.mean %>% filter(group=="Ca A1") %>% arrange(-Mean_prop) %>% pull(Cell_type) %>% rev())
quantiseq.long$sample.id   <- factor(as.character(quantiseq.long$sample.id), levels = quantiseq.long %>% arrange(Cell_type,Proportion) %>% pull(sample.id) %>% rev() %>% unique() %>% rev())
ggplot(quantiseq.long %>% filter(group=="Ca A1"), aes(fill = Cell_type, color = Cell_type, y = Proportion, x = sample.id)) +
geom_bar(position = "stack", stat = "identity", width = 1) + theme_classic() +
scale_fill_manual(values=cell10) + scale_color_manual(values=cell10) + coord_cartesian(xlim=c(0,nmax)) +
theme(legend.position = "none",axis.ticks.x = element_blank(),axis.text.x = element_blank(),axis.title.x = element_blank())
p5d_1 <- ggplot(quantiseq.long %>% filter(group=="Ca A1"), aes(fill = Cell_type, color = Cell_type, y = Proportion, x = sample.id)) +
geom_bar(position = "stack", stat = "identity", width = 1) + theme_classic() +
scale_fill_manual(values=cell10) + scale_color_manual(values=cell10) + coord_cartesian(xlim=c(0,nmax)) +
theme(legend.position = "none",axis.ticks.x = element_blank(),axis.text.x = element_blank(),axis.title.x = element_blank())

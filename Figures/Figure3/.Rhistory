# Create a directory for sample files
dir.create("sample_data", showWarnings = FALSE)
# Generate 200 sample CSV files with different data
set.seed(123)
for (i in 1:200) {
df <- data.frame(
id = 1:10000,
value1 = rnorm(10000, mean = 100, sd = 15),
value2 = rnorm(10000, mean = 50, sd = 10),
category = sample(letters[1:5], 10000, replace = TRUE)
)
write.csv(df, file.path("sample_data", paste0("data_", i, ".csv")), row.names = FALSE)
}
# Function to process a single file
process_file <- function(filename) {
# Read data
df <- read.csv(filename)
# Perform some calculations
summary_stats <- df |>
group_by(category) |>
summarise(
mean_value1 = mean(value1),
sd_value1 = sd(value1),
mean_value2 = mean(value2),
sd_value2 = sd(value2),
count = n(),
.groups = "drop"
) |>
mutate(
ratio = mean_value1 / mean_value2,
cv = sd_value1 / mean_value1  # coefficient of variation
)
# Add source file information
summary_stats$source_file <- basename(filename)
# Save results
output_file <- gsub("data_", "summary_", filename)
write.csv(summary_stats, output_file, row.names = FALSE)
return(basename(output_file))
}
# Get list of files
files <- list.files("sample_data", pattern = "^data_.*\\.csv$", full.names = TRUE)
# Traditional for loop
tic("For loop (independent)")
for_results <- vector("list", length(files))
for (i in seq_along(files)) {
for_results[[i]] <- process_file(files[i])
}
